<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 1999-2026. WebPros International GmbH. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="src/plib/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="src/plib/vendor/autoload.php"
         colors="true">
    <coverage>
        <report>
            <clover outputFile=".phpunit.coverage.xml"/>
        </report>
    </coverage>
    <testsuites>
        <testsuite name="default">
            <directory suffix=".php">tests/unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src/plib</directory>
        </include>
        <exclude>
            <directory>src/plib/vendor</directory>
            <directory>src/plib/resources</directory>
            <directory>src/plib/scripts</directory>
        </exclude>
    </source>
</phpunit>
